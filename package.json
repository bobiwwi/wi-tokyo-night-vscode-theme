{
    "name": "wi-tokyo-night",
    "displayName": "WI Tokyo Night",
    "description": "Tokyo Night with a higher-contrast workbench UI (sidebar, tabs, lists, activity bar) and a pastel blue status bar.",
    "version": "1.2.0",
    "publisher": "bobiwwi",
    "license": "MIT",
    "keywords": [
        "theme",
        "contrast",
        "dark",
        "light",
        "tokyo",
        "clean"
    ],
    "icon": "icon.png",
    "homepage": "https://github.com/bobiwwi/wi-tokyo-night-vscode-theme",
    "repository": {
        "url": "https://github.com/bobiwwi/wi-tokyo-night-vscode-theme",
        "type": "git"
    },
    "bugs": {
        "url": "https://github.com/bobiwwi/wi-tokyo-night-vscode-theme/issues"
    },
    "galleryBanner": {
        "color": "#1f2335",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.17.0"
    },
    "categories": [
        "Themes",
        "Other"
    ],
    "contributes": {
        "themes": [
            {
                "label": "WI Tokyo Night",
                "uiTheme": "vs-dark",
                "path": "./themes/tokyo-night-color-theme.json"
            },
            {
                "label": "WI Tokyo Night Storm",
                "uiTheme": "vs-dark",
                "path": "./themes/tokyo-night-storm-color-theme.json"
            },
            {
                "label": "WI Tokyo Night Light",
                "uiTheme": "vs",
                "path": "./themes/tokyo-night-light-color-theme.json"
            }
        ]
    },
    "scripts": {
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "vsce": "^2.15.0"
    }
}
